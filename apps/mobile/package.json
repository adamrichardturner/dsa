    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "eas-cli": "^25.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build:ios:dev": "mkdir -p builds/ios && EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$(pwd)/builds/ios\" eas build --profile development --platform ios --local",
    "build:ios:dev:device": "mkdir -p builds/ios && EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$(pwd)/builds/ios\" eas build --profile development-device --platform ios --local",
    "build:ios:prod": "eas build --profile production --platform ios",
    "submit:ios": "eas build --profile production --platform ios --auto-submit"
  },
  "private": true
}
