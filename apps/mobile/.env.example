# Required GraphQL endpoint. The app throws if this is missing.
# Local: copy this file to .env.local. Expo inlines EXPO_PUBLIC_* from that file.
# EAS Build and EAS Update: set this same name on the profile environment
# (development or production) as plain text or sensitive, not secret.
# Placeholder for a local API. Do not commit a production URL.
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
EXPO_PUBLIC_WEB_URL=http://localhost:3000
